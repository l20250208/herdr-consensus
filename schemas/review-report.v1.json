{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdr-consensus.dev/schemas/review-report.v1.json",
  "title": "Herdr Consensus review report (v1)",
  "description": "The report an independent reviewer returns between the JSON markers. The runtime validator is the Zod schema in src/consensus/normalizer.ts; this document is the interoperable JSON Schema form.",
  "type": "object",
  "required": ["schemaVersion", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["title", "category", "severity", "impact"],
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "location": {
          "type": ["object", "null"],
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "startLine": { "type": ["integer", "null"] },
            "endLine": { "type": ["integer", "null"] },
            "symbol": { "type": ["string", "null"] }
          }
        },
        "rootCause": { "type": ["string", "null"] },
        "impact": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "reproduction": { "type": "array", "items": { "type": "string" } },
        "suggestedFix": { "type": ["string", "null"] }
      }
    }
  }
}
